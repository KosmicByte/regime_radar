# RegimeRadar configuration (copy to .env, never commit .env)

# Optional: where MarketLake is installed (if present, used preferentially over yfinance fallback)
MARKETLAKE_DATA_DIR=

# Default analysis window (calendar days of daily bars)
REGIME_WINDOW=126

# Default symbol & interval
REGIME_DEFAULT_SYMBOL=^NSEI
REGIME_DEFAULT_INTERVAL=1d

# Where to drop plots and artefacts
REGIME_ARTIFACTS_DIR=./artifacts
